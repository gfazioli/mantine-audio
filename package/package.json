{
  "name": "@gfazioli/mantine-audio",
  "version": "1.1.1",
  "description": "A Mantine-native audio player for React with waveform visualization and live spectrum analyzer, built on Web Audio API. Compound component API + headless useAudio hook.",
  "homepage": "https://gfazioli.github.io/mantine-audio/",
  "packageManager": "yarn@4.0.1",
  "license": "MIT",
  "author": "Giovambattista Fazioli <giovambattista.fazioli@gmail.com>",
  "keywords": [
    "audio",
    "audio-player",
    "component",
    "compound-component",
    "extension",
    "headless",
    "library",
    "mantine",
    "mantine-extension",
    "mantine-ui",
    "mantine-v8",
    "mantine-v9",
    "nextjs",
    "podcast",
    "react",
    "react-audio",
    "react-component",
    "reactjs",
    "spectrum-analyzer",
    "typescript",
    "ui",
    "waveform",
    "web-audio-api"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css"
  },
  "repository": "https://github.com/gfazioli/mantine-audio.git",
  "peerDependencies": {
    "@mantine/core": ">=9.0.0",
    "@mantine/hooks": ">=9.0.0",
    "@tabler/icons-react": ">=3.0.0",
    "react": "^18.x || ^19.x",
    "react-dom": "^18.x || ^19.x"
  },
  "peerDependenciesMeta": {
    "@tabler/icons-react": {
      "optional": true
    }
  },
  "bugs": "https://github.com/gfazioli/mantine-audio/issues"
}
